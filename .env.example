# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=restaurant_offpeak
# Host-side port mapping for the postgres container. Default 5433 (not 5432) to avoid
# colliding with a native Postgres that may already be running on the host.
POSTGRES_HOST_PORT=5433
# Used by api/bot containers over the Docker network — do not change "postgres" host.
DATABASE_URL=postgresql://app:app@postgres:5432/restaurant_offpeak?schema=public
# Used when running Prisma CLI (migrate/studio) directly from the host machine.
DATABASE_URL_HOST=postgresql://app:app@localhost:5433/restaurant_offpeak?schema=public

# Telegram bot
BOT_TOKEN=123456:REPLACE_ME
# Comma-separated Telegram user ids allowed to run /register_restaurant and /add_staff
ADMIN_TELEGRAM_IDS=123456789

# API
API_PORT=3000
API_HOST=0.0.0.0

# Mini App (public HTTPS URL, e.g. ngrok/cloudflared tunnel in dev)
WEBAPP_URL=https://example.ngrok-free.app

# Reminders job: how long before the slot the bot reminds the guest
REMINDER_LEAD_MINUTES=120
# Single time zone for all restaurants (MVP): slot times are wall-clock times in this zone
APP_TIMEZONE=Europe/Moscow
# Unmarked bookings become "no-show" this many minutes after the slot ends
NO_SHOW_GRACE_MINUTES=30

# Slot generation job: how many days ahead to materialize Slot rows from active Offers
SLOT_GENERATION_HORIZON_DAYS=14
